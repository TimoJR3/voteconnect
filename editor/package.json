{
  "name": "voteconnect-editor",
  "private": true,
  "description": "Редактор инициатив на Yoopta-Editor, собирается в assets/js/editor.bundle.js",
  "scripts": {
    "build": "node node_modules/esbuild-wasm/bin/esbuild src/editor.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../assets/js/editor.bundle.js --loader:.css=empty"
  },
  "dependencies": {
    "@yoopta/blockquote": "6.0.5",
    "@yoopta/editor": "6.0.5",
    "@yoopta/exports": "6.0.5",
    "@yoopta/headings": "6.0.5",
    "@yoopta/lists": "6.0.5",
    "@yoopta/marks": "6.0.5",
    "@yoopta/paragraph": "6.0.5",
    "@yoopta/ui": "6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slate": "^0.120.0",
    "slate-dom": "^0.119.0",
    "slate-react": "^0.120.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.0"
  }
}
