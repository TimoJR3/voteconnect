{
  "name": "voteconnect-scene",
  "private": true,
  "description": "3D-макет района и модель согласия групп на three.js, собирается в assets/js/scene.bundle.js",
  "scripts": {
    "build": "node node_modules/esbuild-wasm/bin/esbuild src/scene.js --bundle --minify --format=iife --target=es2019 --outfile=../assets/js/scene.bundle.js"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild-wasm": "0.25.0"
  }
}
